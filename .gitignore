# Public repository allowlist. New top-level content needs explicit review.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/LICENSE
!/DATA_LICENSE.md
!/THIRD_PARTY_NOTICES.md
!/DEPLOY.md
!/package.json
!/package-lock.json
!/public/
!/datasets/
!/docs/
!/.github/
!/scripts/
/scripts/*
!/scripts/build.mjs
!/scripts/contract.mjs
!/scripts/import.mjs
!/scripts/serve.mjs
!/scripts/validate.mjs
!/scripts/export-data.mjs
!/scripts/check-public.mjs
!/scripts/parks-crawl.mjs
!/scripts/nypl.mjs
!/scripts/nassau-discover.py
!/scripts/nassau-collect.py
!/scripts/nassau-supplement.py
!/scripts/geocode-census.mjs
!/scripts/publish.mjs
!/tests/
/tests/*
!/tests/filters.test.mjs
!/tests/parks.test.mjs
!/tests/nypl.test.mjs
!/tests/nassau.test.mjs
!/tests/browser.mjs
**/*.env
**/.env
**/.env.*
**/*.log
**/.DS_Store
**/__pycache__/
